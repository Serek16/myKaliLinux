### git
alias ga="mygit add"
alias gr="mygit restore"
alias grs="mygit restore --staged"
alias gs="git status"
alias gl="git log --oneline --decorate"
alias glo="git log"
unalias gd
gd() {
  git diff $@ | $bat
}

mygit() {
    local files
    local gdiff

    if [[ "$1" == "restore" && "$2" == "--staged" ]]; then
      gdiff=$(git diff --name-only --cached)
    elif [[ "$1" == "add" && "$2" == "." ]]; then
      git add .
    else
      gdiff=$({git diff --name-only; git ls-files --others --exclude-standard})
    fi

    if [[ ! $? -eq 0 || -z $gdiff ]]; then
      return
    fi

    files=$(echo $gdiff | fzf -m)
    if [[ -n "$files" ]]; then
       git $@ $(echo -e $files | tr '\n' ' ')
    fi
}

# Pendrive storage and veracrypt container aliases and commands
sto="/media/pendrive"
alias storage="cd $sto"
alias sto=storage

enc="/media/veracrypt"
function encrypted() {
  if [ -w "$enc" ]; then
    cd "$enc"
  else
    echo "Veracrypt storage isn't mounted. Mounting now..."
    mount-encrypted-storage
    if [ $? == 0 ]; then
      cd "$enc"
    fi
  fi
}
alias enc=encrypted

function close_encrypted() {
  echo "Closing encrypted VeraCrypt storage..."
  cd $HOME
  sudo cryptsetup close encrypted-container
  sudo umount /media/veracrypt
}
alias encx=close_encrypted

[ -s "$sto/.zshrcplus" ] && source "$enc/.zshrcplus"
[ -s "$enc/.zshrcplus" ] && source "$sto/.zshrcplus"

# Hashcat utils commands
function ion() {
  sudo ip link set wlan0 down
  sudo iw wlan0 set type managed
  sudo ip link set wlan0 up
  sudo systemctl start wpa_supplicant
  sudo systemctl start NetworkManager
}

function ioff() {
  sudo systemctl stop NetworkManager
  sudo systemctl stop wpa_supplicant
}

# https://stackoverflow.com/a/24967501
manopt() {
  local cmd=$1 opt=$2
  [[ $opt == -* ]] || { (( ${#opt} == 1 )) && opt="-$opt" || opt="--$opt"; }
  man "$cmd" | col -b | awk -v opt="$opt" -v RS= '$0 ~ "(^|,)[[:blank:]]+" opt "([[:punct:][:space:]]|$)"'
}

# Launch tmux at start
if [ ! -f "$HOME/.tmux_off" ] && [ -f /usr/bin/tmux ] && [ -n "$PS1" ] && [[ ! "$TERM" =~ screen ]] && [[ ! "$TERM" =~ tmux ]] && [ -z "$TMUX" ]; then
  session_name="main"
  if ! tmux has-session -t $session_name 2>/dev/null; then
    exec tmux new-session -s $session_name
  else
    if tmux list-sessions -F "#{session_name}: #{session_attached}" | grep -q "^$session_name: 1$"; then
      exec tmux new-session
    else
      exec tmux attach-session -t $session_name
    fi
  fi
fi

