# Show files in the directory you switch to
function cd() {
  builtin cd "$1" && ls
}

function bak() {
  /usr/bin/cp -i "$1" "$1.bak"
}

function rs() {
  if [ $# -gt 2 ]; then
    echo "Only two arguments are available at the moment"
    return 1
  fi

  if [ -f "$1" ]; then
    if [ -f "$2" ] || ([ -d "$2" ] && [ -f "$(realpath "$2")/$(basename "$1")" ]); then
      read -r "answer?File \"$(realpath "$2")/$(basename "$1")\" already exists. Replace? (y/N): "
      if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        return 1
      fi
    fi
    if [[ ${2[-1]} == "/" ]] && [ ! -d "$2" ]; then
      read -r "answer?Directory \"$(basename "$2")\" doesn't exist. Replace? (y/N): "
      if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        return 1
      fi
    fi
    rsync --info=progress2 -ahz "$1" "$2"
    return
  fi

  if [ -d "$1" ] && [[ ${2[-1]} == "/" ]]; then
    if [ -d "$(realpath "$2")/$(basename "$1")" ]; then
      read -r "answer?Directory \"$(realpath "$2")/$(basename "$1")\" already exist. Replace? (y/N): "
      if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        return 1
      fi
    fi
    rsync --info=progress2 -ahz "$(realpath "$1")/" "$2/$(basename "$1")"
    return
  fi

  if [ -d "$1" ] && [[ ${2[-1]} != "/" ]]; then
    if [ -d "$2" ]; then
      read -r "answer?Directory \"$(realpath "$2")\" already exist. Replace? (y/N): "
      if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        return 1
      fi
    fi
    rsync --info=progress2 -ahz "$(realpath "$1")/" "$2"
    return
  fi

  echo "Error"
  if [ ! -f "$1" ]; then
    echo "No such file \"$1\""
  fi
}

